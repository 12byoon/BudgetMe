# Copy this file to .env and fill in values. .env is git-ignored.

# Flask session signing key. Any random string for local dev.
SECRET_KEY=dev-secret-change-me

# Server (optional; run.py defaults shown)
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=1

# Teller Connect (browser bank-link flow used by the web app).
# The default app id below is a public sandbox id that ships with the project.
TELLER_APP_ID=app_p4epsc4h1j499fkuv0000
TELLER_ENV=sandbox

# Only needed for the standalone teller.py probe (direct Teller API over mTLS).
# Leave blank unless you have Teller client certificates.
TELLER_ACCESS_TOKEN=
TELLER_CERT_FILE=
TELLER_KEY_FILE=
