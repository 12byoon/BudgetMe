# Copy this file to .env and fill in values. .env is git-ignored.

# Flask session signing key. Any random string. Required when FLASK_DEBUG=0.
SECRET_KEY=dev-secret-change-me

# Server (optional; run.py defaults shown)
HOST=127.0.0.1
PORT=8000
FLASK_DEBUG=1

# Plaid - free sandbox, no credit card.
# Sign up at https://dashboard.plaid.com/signup, then copy your Client ID and
# the *Sandbox* secret from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
